# OpenSMTPD 7.8 — private SMTP for a Tailscale tailnet
# Rendered by install-mail.sh; edit the template, not this file.

# Tailscale-issued certificate for the MagicDNS name.
pki mail.ts cert "/etc/ssl/tailscale/mail.crt"
pki mail.ts key "/etc/ssl/tailscale/mail.key"

table aliases file:/etc/aliases

# Local scripts on this machine: plain SMTP, no auth, loopback only.
listen on 127.0.0.1 port 25

# Tailnet clients: implicit TLS (465) and STARTTLS (587). Both require AUTH.
listen on __BIND_IP__ port 465 smtps pki mail.ts auth
listen on __BIND_IP__ port 587 tls-require pki mail.ts auth

# Hand everything addressed to this host to Dovecot over LMTP.
action "local_lmtp" lmtp "/var/run/dovecot/lmtp" alias <aliases>

# Local submissions (sendmail, cron, agent scripts on this box).
match from local for local action "local_lmtp"
match from local for domain "__DOMAIN__" action "local_lmtp"

# Authenticated tailnet users and agents. `from auth` matches any session
# that passed SMTP AUTH, regardless of source IP.
match from auth for local action "local_lmtp"
match from auth for domain "__DOMAIN__" action "local_lmtp"

# Any other recipient (e.g. gmail.com) is intentionally left unmatched:
# OpenSMTPD rejects it. Add a relay action if you ever want internet mail.
