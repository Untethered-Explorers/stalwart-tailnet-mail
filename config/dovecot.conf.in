# Dovecot CE 2.4 — tailnet-only IMAP + LMTP
# Rendered by install-mail.sh; edit the template, not this file.

dovecot_config_version = 2.4.0
dovecot_storage_version = 2.4.0

protocols = imap lmtp

# Only loopback and the Tailscale address. Nothing is reachable from the
# public internet, and no wildcard socket is ever opened.
listen = 127.0.0.1, __BIND_IP__

# TLS is mandatory. The master process reads the key as root before dropping
# privileges, so the key can stay root-only.
ssl = required
ssl_server_cert_file = /etc/ssl/tailscale/mail.crt
ssl_server_key_file = /etc/ssl/tailscale/mail.key
ssl_min_protocol = TLSv1.2

# Maildir under each account's home directory. `~` expands to the home that
# userdb passwd reports (Dovecot 2.4's documented form for system users).
mail_driver = maildir
mail_path = ~/Maildir

namespace inbox {
  inbox = yes
  mailbox Drafts {
    auto = subscribe
    special_use = \Drafts
  }
  mailbox Sent {
    auto = subscribe
    special_use = \Sent
  }
  mailbox Trash {
    auto = subscribe
    special_use = \Trash
  }
  mailbox Junk {
    auto = subscribe
    special_use = \Junk
  }
}

# Authenticate Linux system accounts through PAM (/etc/pam.d/dovecot).
passdb pam {
}
userdb passwd {
}

# LMTP socket that OpenSMTPD writes to. OpenSMTPD does not deliver as a
# daemon user: it forks, drops to the *recipient's* uid/gid, then execs
# mail.lmtp (usr.sbin/smtpd/smtpd.c). The socket therefore has to be writable
# by every mail user, which is why Dovecot's own default here is 0666.
# This grants nothing new locally: the 127.0.0.1:25 listener already accepts
# unauthenticated local mail for local domains.
service lmtp {
  unix_listener lmtp {
    mode = 0666
  }
}

service imap-login {
  # Plaintext IMAP is disabled outright (port 0), not merely discouraged.
  inet_listener imap {
    port = 0
  }
  inet_listener imaps {
    port = 993
    ssl = yes
  }
}
