#!/bin/sh
# Renew the Tailscale HTTPS certificate used by Stalwart.
# Installed to /usr/local/sbin/mail-cert-renew by migrate/85-cert-renewal.sh.
#
# Stalwart keeps certificates in its data store as Certificate objects, not as
# file paths, so a renewed certificate has to be written through the admin JMAP
# API. The API key lives in /root/stalwart-api-key (mode 0600).
#
# The daemons restart only when the certificate actually changed.

set -eu

DOMAIN="__DOMAIN__"
CERT=/etc/ssl/tailscale/mail.crt
KEY=/etc/ssl/tailscale/mail.key
TOKEN_FILE=/root/stalwart-api-key

tmp="$(mktemp -d)"
trap 'rm -rf "$tmp"' EXIT

tailscale cert --cert-file "$tmp/mail.crt" --key-file "$tmp/mail.key" "$DOMAIN" >/dev/null

if cmp -s "$tmp/mail.crt" "$CERT" && cmp -s "$tmp/mail.key" "$KEY"; then
    exit 0
fi

install -m 0644 -o root -g root "$tmp/mail.crt" "$CERT"
install -m 0600 -o root -g root "$tmp/mail.key" "$KEY"

[ -s "$TOKEN_FILE" ] || {
    echo "mail-cert-renew: $TOKEN_FILE is missing; certificate files updated but Stalwart was not" >&2
    exit 1
}
TOKEN="$(cat "$TOKEN_FILE")"

response="$(curl -fsS \
    -H "Authorization: Bearer $TOKEN" \
    -H 'Content-Type: application/json' \
    -d '{"using":["urn:ietf:params:jmap:core","urn:stalwart:jmap"],"methodCalls":[["x:Certificate/get",{"ids":null},"0"]]}' \
    "https://$DOMAIN/jmap/")"

cert_id="$(printf '%s' "$response" | jq -r '.methodResponses[0][1].list[0].id // empty')"
[ -n "$cert_id" ] || {
    echo "mail-cert-renew: no Certificate object found" >&2
    exit 1
}

payload="$(jq -n --arg id "$cert_id" --rawfile cert "$CERT" --rawfile key "$KEY" '{
    using: ["urn:ietf:params:jmap:core", "urn:stalwart:jmap"],
    methodCalls: [[ "x:Certificate/set", {
        update: { ($id): {
            certificate: { "@type": "Text", value: $cert },
            privateKey: { "@type": "Text", secret: $key }
        } }
    }, "0" ]]
}')"

curl -fsS \
    -H "Authorization: Bearer $TOKEN" \
    -H 'Content-Type: application/json' \
    -d "$payload" \
    "https://$DOMAIN/jmap/" >/dev/null

systemctl restart stalwart.service
